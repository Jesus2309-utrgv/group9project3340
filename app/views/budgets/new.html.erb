<h1>Set a New Budget</h1>

<%= form_with model: @budget, local: true do |form| %>
  <div>
    <%= form.label :category %>
    <%= form.text_field :category %>
  </div>

  <div>
    <%= form.label :amount %>
    <%= form.number_field :amount, step: 0.01 %>
  </div>

  <%= form.submit "Save Budget" %>
  
  <%= link_to "Back to Transactions", transactions_path, class: "btn btn-secondary" %>

<% end %>
