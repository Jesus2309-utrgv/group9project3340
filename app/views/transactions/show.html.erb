<h1>Are you sure you want to erase this transaction?</h1>

<p><strong>Description:</strong> <%= @transaction.description %></p>
<p><strong>Amount:</strong> <%= number_to_currency(@transaction.amount) %></p>
<p><strong>Type:</strong> <%= @transaction.transaction_type.capitalize %></p>
<p><strong>Date:</strong> <%= @transaction.transaction_date %></p>
<p><strong>Category:</strong> <%= @transaction.category %></p>

<br>

<%= link_to "Edit", edit_transaction_path(@transaction), class: "btn btn-primary" %>
<%= link_to "Erase Transaction", transaction_path(@transaction), 
            method: :delete, 
            data: { confirm: "Are you sure you want to delete this transaction?" }, 
            class: "btn btn-danger" %>
<%= link_to "Back to List", transactions_path, class: "btn btn-secondary" %>
