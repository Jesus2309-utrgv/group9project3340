<h1>Transaction History</h1>

<p>Total Available Funds: <%= number_to_currency(@total_balance) %></p>

<%= form_with url: transactions_path, method: :get, local: true do %>
  <label>Filter by Type:</label>
  <%= select_tag :filter, options_for_select(['All', 'income', 'expense', 'withdrawal', 'saving'], params[:filter]), include_blank: true %>
  <%= submit_tag "Apply Filter" %>
<% end %>



<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Description</th>
      <th>Amount</th>
      <th>Type</th>
      <th>Category</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @transactions.each do |transaction| %>
      <tr>
        <td><%= transaction.transaction_date %></td>
        <td><%= transaction.description %></td>
<%# number_to_currency(transaction.amount) %>
 <td style="color: <%= %w[withdrawal expense].include?(transaction.transaction_type) ? 'red' : 'black' %>;">
  <%= number_to_currency(transaction.amount) %> </td>
        <td><%= transaction.transaction_type %></td>
        <td><%= transaction.category || 'N/A' %></td>
        <td>
          <%= link_to 'Delete', transaction, method: :delete, data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add Transaction', new_transaction_path, class: 'button' %>
